# wlame-dx yapılandırması
# Kopyalayın: copy .env.example .env  (veya değişkenleri ortama verin)

# Sunucu
PORT=8787
HOST=127.0.0.1

# --- Google web sonuçları (opsiyonel) ---
# Google'ın sonuç sayfası bot koruması döndürdüğü için doğrudan kazınmaz.
# Gerçek Google web sonuçları için Programmable Search / Custom Search JSON API anahtarı girin:
#   https://developers.google.com/custom-search/v1/overview
# Anahtar yoksa Google yine de otomatik tamamlama + Haberler RSS ile çalışır.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Yedek web motoru (opsiyonel) ---
# DuckDuckGo bot korumasına takıldığında kullanılır. Varsayılan: bing
WEB_FALLBACK=bing

# Brave Search API — anahtar verilirse ikinci yedek web motoru olur:
#   https://brave.com/search/api/
BRAVE_API_KEY=

# --- DuckDuckGo dayanıklılık ayarları ---
WLAME_DDG_INTERVAL=1600
WLAME_DDG_FAILURES=2
WLAME_DDG_COOLDOWN=300000

# --- AI modu (opsiyonel) ---
# Boş bırakılırsa anahtar gerektirmeyen yerel özütleyici motor çalışır.
# OpenAI uyumlu herhangi bir uç nokta olabilir (OpenAI, Groq, Together, yerel Ollama vb.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# İstek günlüğünü kapatmak için 0 yapın
WLAME_LOG=1
